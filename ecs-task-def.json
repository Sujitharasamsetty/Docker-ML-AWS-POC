{
  "family": "myapi",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::441778934276:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "myapi",
      "image": "REPLACE_ME_LATER_IN_ACTION",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
