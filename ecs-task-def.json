{
    "family": "myapi-task",
    "executionRoleArn": "arn:aws:iam::441778934276:role/ECS_Task_AI_POC",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "containerDefinitions": [
      {
        "name": "myapi",
        "image": "441778934276.dkr.ecr.us-east-1.amazonaws.com/myapi:latest",
        "portMappings": [
          {
            "containerPort": 4000,
            "protocol": "tcp"
          }
        ],
        "essential": true
      }
    ]
  }
  