{
    "family": "myapi-task",
    "executionRoleArn": "arn:aws:iam::441778934276:role/ECS_Task_AI_POC",  // role
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "containerDefinitions": [
      {
        "name": "myapi",
        "image": "REPLACE_ME",
        "portMappings": [
          {
            "containerPort": 4000,
            "protocol": "tcp"
          }
        ],
        "essential": true,
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/myapi",
            "awslogs-region": "us-east-1",
            "awslogs-stream-prefix": "ecs"
          }
        }
      }
    ]
  }
  